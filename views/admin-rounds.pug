extends base-admin.pug

block head
    title Управление раудами

block center-panel
    h2 Раунды
    form#roundForm
        input#round(name="round")
        button(type="submit") Добавить
    table
        tr
            th(class="col-center") Название
            th(class="col-center") Дата
            th(class="col-center") Обработан
            th(class="col-center") Обработка
            th(class="col-center") Удалить
        each val in rounds
            tr
                td(class="col-left")
                    a(href= '/round/' + val.id)= val.name
                td(class="col-center")= val.date.toLocaleDateString()
                td(class="col-center")= val.processed ? 'Да' : 'Нет'
                td(class="col-center")
                    a(href= 'round/process/' + val.id)= val.processed ? 'Переобработка' : 'Обработка'
                td(class="col-center")
                    a(href= 'round/remove/' + val.id) Удалить

block script
    script.
        document.getElementById('roundForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const roundId = document.getElementById('round').value;
            if (roundId) {
                window.location.href = 'round/add/' + roundId;
            }
        });