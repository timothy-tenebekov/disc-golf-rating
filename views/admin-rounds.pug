extends base-admin.pug

block head
    title Управление раудами

block center-panel
    h2 Раунды
    form#roundForm
        input#round(name="round")
        button(type="submit") Добавить
    table
        tr
            th.col-center Название
            th.col-center Дата
            th.col-rotate Обработан
            th.col-center Обработка
            th.col-center Отмена
        each val in rounds
            tr
                td.col-left
                    a(href= '/round/' + val.id)= val.name
                td.col-center= formatDate(val.date)
                td.col-center= val.processed ? 'Да' : 'Нет'
                td.col-center
                    a(href= 'round/process/' + val.id)= val.processed ? 'Переобработка' : 'Обработка'
                td.col-center
                    if (val.processed)
                        a(href= 'round/cancel/' + val.id) Отмена
                    else
                        a(href= 'round/remove/' + val.id) Удаление

block script
    script.
        document.getElementById('roundForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const roundId = document.getElementById('round').value;
            if (roundId) {
                window.location.href = 'round/add/' + roundId;
            }
        });