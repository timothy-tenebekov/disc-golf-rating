extends base-admin.pug

block head
    title Управление раудами

block panel-main
    div.panel.container.container-vert
        div.panel.panel-stats
            h2 Раунды
    div.panel.panel-form
        form#roundForm
            input#round(name="round")
            button(type="submit") Добавить
    div.panel.panel-table
        table
            tr
                th.column-center Название
                th.column-center Дата
                th.column-rotate Обработан
                th.column-center Обработка
                th.column-center Отмена
            each val in rounds
                tr
                    td.column-left
                        a(href= '/round/' + val.id)= val.name
                    td.column-center= formatDate(val.date)
                    td.column-center= val.processed ? 'Да' : 'Нет'
                    td.column-center
                        a(href= 'round/process/' + val.id)= val.processed ? 'Переобработка' : 'Обработка'
                    td.column-center
                        if (val.processed)
                            a(href= 'round/cancel/' + val.id) Отмена
                        else
                            a(href= 'round/remove/' + val.id) Удаление

block script
    script.
        document.getElementById('roundForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const roundId = document.getElementById('round').value;
            if (roundId) {
                window.location.href = 'round/add/' + roundId;
            }
        });