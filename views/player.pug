extends base-main.pug

block head
    title Игрок

block panel-main
    div.container.container-vert
        div.panel.panel-stats
            h2= player.name
        div.panel.container.horz-container
            div.panel-stats
                h4= 'Рейтинг: ' + (player.rating > 0 ? player.rating : 'нет')
            div.panel.panel-stats
                h4= 'Место: ' + (player.rank > 0 ? player.rank : 'нет')
            if player.gender
                div.panel.panel-stats
                    h4= 'Место (' + (player.gender == 'm' ? 'М' : 'Ж') + '): ' + (player.genderRank > 0 ? player.genderRank : 'нет')
        div.panel.panel-stats
            h4
                a(href= 'https://discgolfmetrix.com/player/' + player.id target='_blank' rel='noopener noreferrer') Metrix
    div.panel.panel-table
        table
            tr
                th.column-center Раунд
                th.column-center Дата
                th.column-center Трасса
                th.column-rotate Корзины
                th.column-rotate Результат
                th.column-rotate Рейтинг за раунд
            each val in rounds
                tr
                    td.column-left(class={'column-inactive': !val.active})
                        a(href= '/round/' + val.id)= val.name
                    td.column-center(class={'column-inactive': !val.active})= formatDate(val.date)
                    td.column-left(class={'column-inactive': !val.active})= val.courseName
                    td.column-center(class={'column-inactive': !val.active})= val.baskets
                    td.column-center(class={'column-inactive': !val.active})= (val.result > 0 ? "+" : "") + val.result
                    td.column-center(class={'column-inactive': !val.active})= val.rating
    if ratings.length > 0
        div.panel.panel-chart
            canvas#chart

block script
    if ratings.length > 0
        script(src='https://cdn.jsdelivr.net/npm/chart.js')
        script(src='https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js')
        -
            var chartRatings = ratings.map(item => ({
                x: item.date,
                y: item.rating,
                date: formatDate(item.date)
            }));
            var chartRounds = rounds
                    .filter(item => item.rating > 0)
                    .map(item => ({
                        x: item.date,
                        y: item.rating,
                        name: item.name,
                        date: formatDate(item.date)
                    }));
        script.
            const ratings = !{JSON.stringify(chartRatings)};
            const rounds = !{JSON.stringify(chartRounds)};
            const ctx = document.getElementById('chart').getContext('2d');
            new Chart(ctx, {
                data: {
                    datasets: [
                        {
                            type: 'scatter',
                            label: 'Раунды',
                            data: rounds,
                            order: 2,
                            pointRadius: 4,
                            pointHoverRadius: 5
                        },
                        {
                            type: 'line',
                            label: 'Текущий рейтинг',
                            data: ratings,
                            order: 1
                        }
                    ],
                },
                options: {
                    responsive: false,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'month',
                                displayFormats: {
                                    month: 'MMM yyyy'
                                }
                            },
                            offset: true
                        },
                        y: {
                            offset: true
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                title: () => '',
                                label: function (context) {
                                    if (context.datasetIndex === 1) {
                                        return [
                                            `Дата: ${context.raw.date}`,
                                            `Рейтинг: ${context.raw.y}`
                                        ];
                                    } else if (context.datasetIndex === 0) {
                                        return [
                                            context.raw.name,
                                            `Дата: ${context.raw.date}`,
                                            `Рейтинг: ${context.raw.y}`
                                        ];
                                    }
                                    return context.label;
                                }
                            }
                        }
                    }
                }
            });