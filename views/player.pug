extends base-main.pug

block head
    title Игрок

block center-panel
    h2= 'Игрок: ' + player.metrixName
    h4= 'Текущий рейтинг: ' + (player.rating > 0 ? player.rating : 'нет')
    h4
        a(href= 'https://discgolfmetrix.com/player/' + player.id target='_blank' rel='noopener noreferrer') Metrix
    table
        tr
            th(class="col-center") Раунд
            th(class="col-center") Дата
            th(class="col-center") Трасса
            th(class="col-center") Корзины
            th(class="col-center") Результат
            th(class="col-center") Рейтинг<br>за раунд
        - var baskets = 0
        each val in rounds
            - var extraClass = baskets >= maxBaskets ? " col-grey" : ""
            tr
                td(class="col-left" + extraClass)
                    a(href= '/round/' + val.id)= val.name
                td(class="col-center" + extraClass)= val.datetime.toLocaleString()
                td(class="col-left" + extraClass)= val.courseName
                td(class="col-center" + extraClass)= val.baskets
                td(class="col-center" + extraClass)= (val.result > 0 ? "+" : "") + val.result
                td(class="col-center" + extraClass)= val.rating
            - if (val.rating) baskets += val.baskets
