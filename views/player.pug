extends base-main.pug

block head
    title Игрок

block center-panel
    h2= 'Игрок: ' + player.metrixName
    h4= 'Текущий рейтинг: ' + (player.rating > 0 ? player.rating : 'нет')
    h4
        a(href= 'https://discgolfmetrix.com/player/' + player.id target='_blank' rel='noopener noreferrer') Metrix
    table
        tr
            th.col-center Раунд
            th.col-center Дата
            th.col-center Трасса
            th.col-center Корзины
            th.col-center Результат
            th.col-center Рейтинг<br>за раунд
        each val in rounds
            tr
                td.col-left(class={'col-grey': !val.active})
                    a(href= '/round/' + val.id)= val.name
                td.col-center(class={'col-grey': !val.active})= formatDate(val.date)
                td.col-left(class={'col-grey': !val.active})= val.courseName
                td.col-center(class={'col-grey': !val.active})= val.baskets
                td.col-center(class={'col-grey': !val.active})= (val.result > 0 ? "+" : "") + val.result
                td.col-center(class={'col-grey': !val.active})= val.rating
    if ratings.length > 0
        br
        canvas#chart

block script
    if ratings.length > 0
        script(src='https://cdn.jsdelivr.net/npm/chart.js')
        script(src='https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js')
        -
            var chartRatings = ratings.map(item => ({
                x: item.date,
                y: item.rating,
                date: formatDate(item.date)
            }));
            var chartRounds = rounds
                    .filter(item => item.rating > 0)
                    .map(item => ({
                        x: item.date,
                        y: item.rating,
                        name: item.name,
                        date: formatDate(item.date)
                    }));
        script.
            const ratings = !{JSON.stringify(chartRatings)};
            const rounds = !{JSON.stringify(chartRounds)};
            const ctx = document.getElementById('chart').getContext('2d');
            new Chart(ctx, {
                data: {
                    datasets: [
                        {
                            type: 'scatter',
                            label: 'Раунды',
                            data: rounds,
                            order: 2,
                            pointRadius: 4,
                            pointHoverRadius: 5
                        },
                        {
                            type: 'line',
                            label: 'Текущий рейтинг',
                            data: ratings,
                            order: 1
                        }
                    ],
                },
                options: {
                    responsive: false,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'month',
                                displayFormats: {
                                    month: 'MMM yy'
                                }
                            },
                            offset: true
                        },
                        y: {
                            offset: true
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                title: () => '',
                                label: function (context) {
                                    if (context.datasetIndex === 1) {
                                        return [
                                            `Дата: ${context.raw.date}`,
                                            `Рейтинг: ${context.raw.y}`
                                        ];
                                    } else if (context.datasetIndex === 0) {
                                        return [
                                            context.raw.name,
                                            `Дата: ${context.raw.date}`,
                                            `Рейтинг: ${context.raw.y}`
                                        ];
                                    }
                                    return context.label;
                                }
                            }
                        }
                    }
                }
            });