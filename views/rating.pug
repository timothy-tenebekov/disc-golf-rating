extends base-main.pug

block head
    title Рейтинг

block center-panel
    if date
        form#dateForm
            label(for="date") Рейтинг на
            select#date(name="date" onchange="window.location = '/rating/' + this.value")
                each val in dates
                    option(value=val selected=(val === date))= new Date(val).toLocaleDateString()
    else
        h4 Рейтинг не найден
    if ratings
        table
            tr
                th.col-center Игрок
                th.col-center Рейтинг
            each val in ratings
                tr
                    td.col-left
                        a(href= '/player/' + val.id)= val.metrixName
                    td.col-center= val.rating
