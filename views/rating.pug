extends base-main.pug

block head
    title Рейтинг

block panel-main
    div.panel.container.container-vert
        if date
            div.panel.panel-form
                form#dateForm
                    label(for="gender") Тип
                    select#gender(name="gender")
                        option(value='' selected=(gender === null)) Общий
                        option(value='m' selected=(gender === 'm')) Мужской
                        option(value='f' selected=(gender === 'f')) Женский
                    label(for="date") Рейтинг на
                    select#date(name="date")
                        each val in dates
                            option(value=val selected=(val === date))= formatDate(val)
        else
            div.panel.panel-stats
                h4 Рейтинг не найден
        if ratings
            div.panel.panel-table
                table
                    tr
                        th.column-center Место
                        th.column-center Игрок
                        th.column-center Рейтинг
                    each val in ratings
                        tr
                            td.column-center= val.rank
                            td.column-left
                                a(href= '/player/' + val.id)= val.name
                            td.column-center= val.rating

block script
    script.
        const genderSelect = document.getElementById('gender');
        const dateSelect = document.getElementById('date');

        function buildUrl() {
            const gender = genderSelect.value;
            const date = dateSelect.value;
            let url = '/rating';
            if (gender) {
                url += '-' + gender;
            }
            url += '/' + date;
            return url;
        }

        function openLink() {
            window.location = buildUrl();
        }

        genderSelect.addEventListener('change', openLink);
        dateSelect.addEventListener('change', openLink);
