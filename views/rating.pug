extends base-main.pug

block head
    title Рейтинг

block center-panel
    if date
        form#dateForm
            label(for="date") Рейтинг на
            select#date(name="date" onchange="window.location = '/rating/' + this.value")
                each val in dates
                    option(value=val.formatted selected=(val.formatted === date))= val.original.toLocaleDateString()
    else
        h4 Рейтинг не найден
    if ratings
        table
            tr
                th(class="col-center") Игрок
                th(class="col-center") Рейтинг
            each val in ratings
                tr
                    td(class="col-left")
                        a(href= '/player/' + val.id)= val.metrixName
                    td(class="col-center")= val.rating
