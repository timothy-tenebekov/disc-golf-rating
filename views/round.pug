extends base-main.pug

block head
    title Раунд

block panel-main
    div.container.container-vert
        div.panel.panel-stats
            h2= round.name
    if round.courseName
        div.panel.panel-stats
            h4= 'Трасса: ' + round.courseName
    div.panel.container.container-horz
        div.panel.panel-stats
            h4= 'Дата: ' + formatDate(round.date)
        if round.baskets > 0
            div.panel.panel-stats
                h4= 'Корзин: ' + round.baskets
    if round.parRating > 0
        div.panel.container.container-horz
            div.panel.panel-stats
                h4= 'Рейтинг пара: ' + round.parRating
            div.panel.panel-stats
                h4= 'Рейтинг очка: ' + round.pointRating
    div.panel.panel-stats
        h4
            a(href= 'https://discgolfmetrix.com/' + round.id target = '_blank' rel='noopener noreferrer') Metrix
    div.panel.panel-table
        table
            tr
                th.column-center Игрок
                th.column-center Результат
                th.column-center Текущий<br>рейтинг
                th.column-center Рейтинг<br>за раунд
            each val in results
                tr
                    td.column-left
                        a(href= '/player/' + val.id)= val.name
                    td.column-center= (val.result > 0 ? "+" : "") + val.result
                    td.column-center= val.playerRating
                    td.column-center= val.roundRating
    if round.parRating > 0
        div.panel.panel-chart
            canvas#chart

block script
    if round.parRating > 0
        script(src='https://cdn.jsdelivr.net/npm/chart.js')
        -
            var chartResults = results
                    .filter(item => item.playerRating > 0)
                    .map(item => ({
                        x: item.result,
                        y: item.playerRating,
                        name: item.name,
                        rating: item.roundRating
                    }));
            const minX = chartResults.at(0).x;
            const maxX = chartResults.at(-1).x;
            const minY = round.parRating - round.pointRating * minX;
            const maxY = round.parRating - round.pointRating * maxX;
            var ratingLine = [[minX, minY], [maxX, maxY]];
        script.
            const results = !{JSON.stringify(chartResults)};
            const line = !{JSON.stringify(ratingLine)};
            const ctx = document.getElementById('chart').getContext('2d');
            new Chart(ctx, {
                type: 'scatter',
                data: {
                    datasets: [
                        {
                            type: 'scatter',
                            label: 'Результат',
                            data: results,
                            pointRadius: 4,
                            pointHoverRadius: 5
                        },
                        {
                            type: 'line',
                            label: 'Рейтинг',
                            data: line,
                            pointStyle: false
                        }
                    ],
                },
                options: {
                    responsive: false,
                    scales: {
                        x: {
                            reverse: true,
                            offset: true,
                            ticks: {
                                callback: (value) => withSign(value)
                            }
                        },
                        y: {
                            offset: true
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            filter: (context) => context.datasetIndex !== 1,
                            callbacks: {
                                label: function (context) {
                                    if (context.datasetIndex === 0) {
                                        const ratingDiff = context.raw.rating - context.raw.y;
                                        return [
                                            context.raw.name,
                                            `Результат: ${withSign(context.raw.x)}`,
                                            `Рейтинг: ${context.raw.y} → ${context.raw.rating} (${withSign(ratingDiff)})`
                                        ];
                                    } else if (context.datasetIndex === 1) {
                                        return [
                                            `Результат: ${withSign(context.parsed.x)}`,
                                            `Рейтинг: ${context.parsed.y}`
                                        ];
                                    }
                                    return context.label;
                                }
                            }
                        }
                    }
                }
            });