extends base-main.pug

block head
    title Раунд

block center-panel
    h2= 'Раунд: ' + round.name
    if round.courseName
        h4= 'Трасса: ' + round.courseName
    h4= 'Дата: ' + round.date.toLocaleDateString()
    if round.baskets > 0
        h4= 'Корзин: ' + round.baskets
    if round.parRating > 0
        h4= 'Рейтинг пара: ' + round.parRating + ', очка: ' + round.pointRating
    h4
        a(href= 'https://discgolfmetrix.com/' + round.id target = '_blank' rel='noopener noreferrer') Metrix
    table
        tr
            th(class="col-center") Игрок
            th(class="col-center") Результат
            th(class="col-center") Текущий<br>рейтинг
            th(class="col-center") Рейтинг<br>за раунд
        each val in results
            tr
                td(class="col-left")
                    a(href= '/player/' + val.id)= val.metrixName
                td(class="col-center")= (val.result > 0 ? "+" : "") + val.result
                td(class="col-center")= val.playerRating
                td(class="col-center")= val.roundRating
    br
    if round.parRating > 0
        canvas#chart

block script
    if round.parRating > 0
        script(src='https://cdn.jsdelivr.net/npm/chart.js')
        script.
            const roundData = !{JSON.stringify(round)};
            const resultsData = !{JSON.stringify(results)};
            const ctx = document.getElementById('chart').getContext('2d');
            const results = resultsData.filter(item => item.playerRating > 0);
            const minResult = results.at(0).result;
            const maxResult = results.at(-1).result;
            const minRating = roundData.parRating - roundData.pointRating * minResult;
            const maxRating = roundData.parRating - roundData.pointRating * maxResult;
            new Chart(ctx, {
                data: {
                    labels: results.map(item => item.metrixName),
                    datasets: [
                        {
                            type: "scatter",
                            label: 'Результат',
                            data: results.map(item => ({
                                x: item.result,
                                y: item.playerRating
                            }))
                        },
                        {
                            type: "line",
                            label: "Рейтинг",
                            data: [[minResult, minRating], [maxResult, maxRating]]
                        }
                    ],
                },
                options: {
                    responsive: false,
                    scales: {
                        x: {
                            reverse: true,
                            min: minResult,
                            max: maxResult,
                            offset: true
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });