extends base-main.pug

block head
    title Раунды

block center-panel
    h2 Раунды
    table
        tr
            th.col-center Название
            th.col-center Дата
            th.col-center Трасса
            th.col-rotate Корзины
            th.col-rotate Рейтинг пара
        each val in rounds
            tr
                td.col-left
                    a(href= '/round/' + val.id)= val.name
                td.col-center= formatDate(val.date)
                td.col-left= val.courseName
                td.col-center= val.baskets
                td.col-center= val.parRating
