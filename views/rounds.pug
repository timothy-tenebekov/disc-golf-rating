extends base-main.pug

block head
    title Раунды

block panel-main
    div.panel.container.container-vert
        div.panel.panel-stats
            h2 Раунды
        div.panel.panel-table
            table
                tr
                    th.column-center Название
                    th.column-center Дата
                    th.column-center Трасса
                    th.column-rotate Корзины
                    th.column-rotate Рейтинг пара
                each val in rounds
                    tr
                        td.col-left
                            a(href= '/round/' + val.id)= val.name
                        td.column-center= formatDate(val.date)
                        td.column-left= val.courseName
                        td.column-center= val.baskets
                        td.column-center= val.parRating
