extends base-main.pug

block head
    title Раунды

block panel-main
    div.panel.container.container-vert
        div.panel.panel-stats
            h2 Раунды
        div.panel.panel-table
            table
                tr
                    th.column-center Раунд
                    th.column-center Дата
                    th.column-center Трасса
                    th.column-rotate Корзины
                    th.column-rotate Рейтинг пара
                each val in rounds
                    tr
                        - var inactive = !val.parRating;
                        td.col-left(class={'column-inactive': inactive})
                            a(href= '/round/' + val.id)= val.name
                        td.column-center(class={'column-inactive': inactive})= formatDate(val.date)
                        td.column-left(class={'column-inactive': inactive})= val.courseName
                        td.column-center(class={'column-inactive': inactive})= val.baskets
                        td.column-center(class={'column-inactive': inactive})= val.parRating
