extends base-main.pug

block head
    title Раунды

block center-panel
    h2 Раунды
    table
        tr
            th(class="col-center") Название
            th(class="col-center") Дата
            th(class="col-center") Трасса
            th(class="col-center") Корзины
            th(class="col-center") Рейтинг<br>пара
        each val in rounds
            tr
                td(class="col-left")
                    a(href= '/round/' + val.id)= val.name
                td(class="col-center")= val.date.toLocaleDateString()
                td(class="col-left")= val.courseName
                td(class="col-center")= val.baskets
                td(class="col-center")= val.parRating
